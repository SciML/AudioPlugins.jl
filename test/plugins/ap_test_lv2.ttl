# Port descriptions of the test plugins in ap_test_lv2.c. The bundle's
# manifest.ttl is written by clap_test_bundle()'s LV2 counterpart at build
# time, because it must name the binary with the platform's extension.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<urn:audioplugins:test:gain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "AudioPlugins Test Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:audioplugins:test:onepole>
    a lv2:Plugin, lv2:FilterPlugin ;
    doap:name "AudioPlugins Test One-Pole" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "a" ; lv2:name "Coefficient" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:audioplugins:test:lookahead>
    a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "AudioPlugins Test Lookahead" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency
    ] .
